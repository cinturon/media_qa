{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media QA Studio",
  "version": "0.1.0",
  "identifier": "studio.mediaqa.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Media QA Studio",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Media delivery QC operator station",
    "longDescription": "Desktop operator station for Media QA Studio delivery checks."
  }
}
